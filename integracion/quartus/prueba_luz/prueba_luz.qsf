# Prueba de los cuatro AR4917 a 3.3 V con LEDR0..3.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY prueba_luz
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name VHDL_FILE ../../../componentes/sensores_luz/vhdl/lectura_luz.vhd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name BDF_FILE prueba_luz.bdf
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE prueba_luz.sdc
set_location_assignment PIN_P11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_location_assignment PIN_V10 -to ldr_d0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ldr_d0[0]
set_location_assignment PIN_W10 -to ldr_d0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ldr_d0[1]
set_location_assignment PIN_V9 -to ldr_d0[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ldr_d0[2]
set_location_assignment PIN_W9 -to ldr_d0[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ldr_d0[3]
set_location_assignment PIN_A8 -to luz[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to luz[0]
set_location_assignment PIN_A9 -to luz[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to luz[1]
set_location_assignment PIN_A10 -to luz[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to luz[2]
set_location_assignment PIN_B10 -to luz[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to luz[3]

set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top